PORT=3000
SHOP_NAME=Style Story
SHOP_CONTACT_NUMBER=YOUR_PUBLIC_STORE_PHONE
SHOP_UPI_ID=YOUR_STORE_UPI_ID

# Set strong values in your hosting provider's Environment Variables; never commit .env.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_SMS_NUMBER=
